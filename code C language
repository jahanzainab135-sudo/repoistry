// Structure to represent CPU components
typedef struct {
    char name[50];
    double speed_ghz;
    int cores;
    unsigned long long operations_per_second;
} CPU;

// Structure for data flow visualization
typedef struct {
    char component[50];
    int data_throughput;
    double latency_ms;
} Component;

// Function prototypes
void visualize_cpu_architecture();
void visualize_data_flow();
void visualize_processing_speed();
void visualize_performance_comparison();
void visualize_instruction_cycle();
void print_bar(int value, int max_value, int width);
void delay(int milliseconds);

int main() {
    int choice;
    
    printf("=================================================\n");
    printf("   COMPUTER SPEED VISUALIZATION PROGRAM\n");
    printf("   Understanding How Computers Work Fast\n");
    printf("=================================================\n\n");
    
    do {
        printf("Choose a visualization:\n");
        printf("1. CPU Architecture Overview\n");
        printf("2. Data Flow Between Components\n");
        printf("3. Processing Speed Demonstration\n");
        printf("4. Performance Comparison (CPU vs GPU)\n");
        printf("5. Instruction Cycle Visualization\n");
        printf("6. Run All Visualizations\n");
        printf("0. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        
        switch(choice) {
            case 1:
                visualize_cpu_architecture();
                break;
            case 2:
                visualize_data_flow();
                break;
            case 3:
                visualize_processing_speed();
                break;
            case 4:
                visualize_performance_comparison();
                break;
            case 5:
                visualize_instruction_cycle();
                break;
            case 6:
                visualize_cpu_architecture();
                visualize_data_flow();
                visualize_processing_speed();
                visualize_performance_comparison();
                visualize_instruction_cycle();
                break;
            case 0:
                printf("Exiting program...\n");
                break;
            default:
                printf("Invalid choice! Please try again.\n");
        }
        
        if(choice != 0) {
            printf("\nPress Enter to continue...");
            while(getchar() != '\n');
            getchar();
            system("clear || cls");
        }
        
    } while(choice != 0);
    
    return 0;
}

