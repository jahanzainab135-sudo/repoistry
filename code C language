// Visualize the instruction cycle of a CPU
void visualize_instruction_cycle() {
    printf("\n=== INSTRUCTION CYCLE VISUALIZATION ===\n\n");
    
    printf("The Fetch-Decode-Execute Cycle (How CPU Processes Instructions):\n\n");
    
    printf("  +-------+     +--------+     +---------+     +--------+\n");
    printf("  | FETCH  |---->| DECODE |---->| EXECUTE |---->| STORE  |\n");
    printf("  +-------+     +--------+     +---------+     +--------+\n");
    printf("      ^                                           |\n    +--+\n");
    printf("      +-------------------------------------------+\n\n");
    
    printf("Detailed Breakdown:\n\n");
    
    printf("1. FETCH: Get instruction from memory\n");
    printf("   - Program Counter (PC) holds instruction address\n");
    printf("   - Instruction fetched from memory\n");
    printf("   - PC incremented to next instruction\n\n");
    
    printf("2. DECODE: Interpret the instruction\n");
    printf("   - Control Unit decodes opcode\n");
    printf("   - Identifies required operands\n");
    printf("   - Prepares necessary components\n\n");
    
    printf("3. EXECUTE: Perform the operation\n");
    printf("   - ALU performs calculation (if arithmetic)\n");
    printf("   - Memory access (if load/store)\n");
    printf("   - Branch decision (if jump/branch)\n\n");
    
    printf("4. STORE: Write back results\n");
    printf("   - Results stored in registers or memory\n");
    printf("   - Flags updated (zero, carry, etc.)\n\n");
    
    printf("This cycle repeats BILLIONS of times per second!\n\n");
    
    // Simulate instruction execution
    printf("Simulating instruction execution (5 cycles):\n\n");
    
    char* instructions[] = {
        "MOV R1, #42",
        "ADD R2, R1, #10",
        "MUL R3, R2, R1",
        "STR R3, [R4]",
        "B loop"
    };
    
    for(int i = 0; i < 5; i++) {
        printf("Cycle %d:\n", i+1);
        printf("  FETCH:  %s\n", instructions[i]);
        printf("  DECODE: Opcode identified\n");
        printf("  EXECUTE: Operation performed\n");
        printf("  STORE: Result saved\n\n");
        delay(500); // Pause for visualization
    }
}

// Helper function to print a visual bar
void print_bar(int value, int max_value, int width) {
    int bar_length = (int)((double)value / max_value * width);
    
    printf("[");
    for(int i = 0; i < width; i++) {
        if(i < bar_length) {
            printf("█");
        } else {
            printf(" ");
        }
    }
    printf("]");
}

// Helper function for delay (cross-platform)
void delay(int milliseconds) {
    clock_t start_time = clock();
    while(clock() < start_time + milliseconds * CLOCKS_PER_SEC / 1000);
}
