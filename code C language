// Visualize data flow between computer components
void visualize_data_flow() {
    printf("\n=== DATA FLOW VISUALIZATION ===\n\n");
    
    Component components[] = {
        {"CPU Registers", 1000000, 0.000001},
        {"L1 Cache", 500000, 0.00001},
        {"L2 Cache", 200000, 0.0001},
        {"L3 Cache", 100000, 0.001},
        {"RAM", 50000, 0.01},
        {"SSD", 5000, 0.1},
        {"HDD", 1500, 10.0}
    };
    
    int num_components = sizeof(components) / sizeof(components[0]);
    
    printf("Data Flow Through Computer Components:\n");
    printf("(Width represents throughput, latency shown in ms)\n\n");
    
    for(int i = 0; i < num_components; i++) {
        printf("%-15s: ", components[i].component);
        print_bar(components[i].data_throughput, 1000000, 50);
        printf(" %10d MB/s | Latency: %.4f ms\n", 
               components[i].data_throughput, components[i].latency_ms);
    }
    
    printf("\nKey Insight: The CPU accesses registers and cache millions of times faster than main memory!\n");
    printf("This hierarchical memory system is crucial for high-speed operation.\n\n");
    
    // Visualize data movement
    printf("Data Movement During Program Execution:\n");
    printf("1. Program loaded from SSD/HDD to RAM\n");
    printf("2. Instructions copied from RAM to Cache\n");
    printf("3. CPU fetches instructions from Cache to Registers\n");
    printf("4. ALU processes data in Registers\n");
    printf("5. Results stored back through the hierarchy\n\n");
}

// Demonstrate processing speed with visual comparison
void visualize_processing_speed() {
    printf("\n=== PROCESSING SPEED DEMONSTRATION ===\n\n");
    
    clock_t start, end;
    double cpu_time_used;
    long long iterations = 1000000000LL; // 1 billion iterations
    
    printf("Performing %lld simple arithmetic operations...\n", iterations);
    
    start = clock();
    
    // Perform simple arithmetic operations
    volatile long long result = 0;
    for(long long i = 0; i < iterations; i++) {
        result += i * 2 + 1;
    }
    
    end = clock();
    cpu_time_used = ((double) (end - start)) / CLOCKS_PER_SEC;
    
    printf("Time taken: %.4f seconds\n", cpu_time_used);
    printf("Operations per second: %.2f billion\n", iterations / cpu_time_used / 1000000000.0);
    printf("Result: %llu (to prevent optimization)\n\n", result);
    
    // Visual comparison
    printf("Visual Speed Comparison:\n");
    printf("Human thinking speed:     ");
    print_bar(1, 100, 50);
    printf(" 1 operation/second\n");
    
    printf("Early computers (ENIAC):  ");
    print_bar(5000, 100000, 50);
    printf(" 5,000 operations/second\n");
    
    printf("Modern CPU:               ");
    print_bar(100000, 100000, 50);
    printf(" 100,000,000,000+ ops/sec\n\n");
    
    printf("That's why computers can handle complex tasks in milliseconds!\n\n");
}

